# Imago environment template — copy to .env (gitignored) and fill in.
# Loaded by `imago` on every run from the current directory; variables already
# present in the real environment take precedence. No inline comments on value lines.

# Required: your model-provider API key (config.toml [model] api_key_env names it).
IMAGO_API_KEY=

# Optional: override the judge model per-run; its use is logged on every call.
# JUDGE_MODEL_OVERRIDE=
